# Projeto Regenere — configuração do Apache na HostGator (cPanel)
#
# O site é 100% estático (Next.js `output: "export"`), então este arquivo cuida
# apenas de: página inicial e 404, HTTPS/domínio canônico, cache e compressão.
# Não editar direto no servidor: a fonte é `web/public/.htaccess` e o deploy
# sobrescreve o arquivo remoto.

DirectoryIndex index.html index.htm
ErrorDocument 404 /404.html

# Sem listagem de diretórios.
Options -Indexes

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS. A segunda condição evita loop de redirecionamento caso o TLS
  # seja terminado por um proxy à frente do Apache.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Domínio canônico sem "www" (igual a siteConfig.url).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Marca os assets versionados por hash, para o cache longo abaixo.
  RewriteRule ^_next/static/ - [E=ASSET_IMUTAVEL:1]
</IfModule>

<IfModule mod_headers.c>
  # Arquivos em /_next/static/ têm hash no nome: nunca mudam de conteúdo.
  Header set Cache-Control "public, max-age=31536000, immutable" env=ASSET_IMUTAVEL

  # HTML sempre revalidado, para que uma nova publicação apareça de imediato.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
