# Credenciais de publicação na HostGator (FTP do cPanel).
# Copie para `.env.deploy` e preencha. O arquivo real NÃO é versionado.
#
# Onde encontrar: cPanel → Arquivos → Contas de FTP.
# Use o usuário principal da conta (ou crie um usuário de FTP com acesso a
# public_html e ao diretório pai, necessário para arquivar o site antigo).

FTP_HOST=ftp.projeto-regenere.com.br
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21

# Pasta pública do domínio principal na HostGator.
FTP_REMOTE_DIR=/public_html
